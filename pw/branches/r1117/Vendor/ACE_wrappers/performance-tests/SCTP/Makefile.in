SOCK_STREAM_clt$(EXEEXT): $(SOCK_STREAM_clt_OBJECTS) $(SOCK_STREAM_clt_DEPENDENCIES) $(EXTRA_SOCK_STREAM_clt_DEPENDENCIES) 
