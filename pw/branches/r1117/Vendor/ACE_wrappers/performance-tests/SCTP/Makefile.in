all: all-am

.SUFFIXES:
.SUFFIXES: .cpp .lo .o .obj
$(srcdir)/Makefile.in:  $(srcdir)/Makefile.am  $(am__configure_deps)
	@for dep in $?; do \
	  case '$(am__configure_deps)' in \
	    *$$dep*) \
	      ( cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh ) \
	        && { if test -f $@; then exit 0; else break; fi; }; \
	      exit 1;; \
	  esac; \
	done; \
	echo ' cd $(top_srcdir) && $(AUTOMAKE) --foreign performance-tests/SCTP/Makefile'; \
	$(am__cd) $(top_srcdir) && \
	  $(AUTOMAKE) --foreign performance-tests/SCTP/Makefile
Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
	@case '$?' in \
	  *config.status*) \
	    cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh;; \
	  *) \
	    echo ' cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles)'; \
	    cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles);; \
	esac;

$(top_builddir)/config.status: $(top_srcdir)/configure $(CONFIG_STATUS_DEPENDENCIES)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh

$(top_srcdir)/configure:  $(am__configure_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(ACLOCAL_M4):  $(am__aclocal_m4_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(am__aclocal_m4_deps):

clean-noinstPROGRAMS:
	$(am__rm_f) $(noinst_PROGRAMS)
	test -z "$(EXEEXT)" || $(am__rm_f) $(noinst_PROGRAMS:$(EXEEXT)=)

SOCK_SEQPACK_Association_Test$(EXEEXT): $(SOCK_SEQPACK_Association_Test_OBJECTS) $(SOCK_SEQPACK_Association_Test_DEPENDENCIES) $(EXTRA_SOCK_SEQPACK_Association_Test_DEPENDENCIES) 
	@rm -f SOCK_SEQPACK_Association_Test$(EXEEXT)
	$(AM_V_CXXLD)$(CXXLINK) $(SOCK_SEQPACK_Association_Test_OBJECTS) $(SOCK_SEQPACK_Association_Test_LDADD) $(LIBS)

SOCK_SEQPACK_clt$(EXEEXT): $(SOCK_SEQPACK_clt_OBJECTS) $(SOCK_SEQPACK_clt_DEPENDENCIES) $(EXTRA_SOCK_SEQPACK_clt_DEPENDENCIES) 
