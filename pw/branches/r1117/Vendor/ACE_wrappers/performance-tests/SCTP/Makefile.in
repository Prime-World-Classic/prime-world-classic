	$(AM_V_CXXLD)$(CXXLINK) $(SOCK_STREAM_srv_OBJECTS) $(SOCK_STREAM_srv_LDADD) $(LIBS)

mostlyclean-compile:
	-rm -f *.$(OBJEXT)

distclean-compile:
	-rm -f *.tab.c

