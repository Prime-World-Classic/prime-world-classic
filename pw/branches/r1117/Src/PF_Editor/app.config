<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Нативные C++/CLI-сборки (EditorNative, PF_EditorNative) собраны под CLR 2.0;
       без legacy-активации процесс .NET 4.8 откажется их грузить. -->
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
