# ============================================================
# Build vendored libraries (only those without system equivalents)
# ============================================================

# --- Terabit (depends on ACE) ---
file(GLOB_RECURSE TERABIT_SRCS ${VENDOR}/Terabit/*.cpp ${VENDOR}/Terabit/*.c)
list(FILTER TERABIT_SRCS EXCLUDE REGEX ".*Win.*")
list(FILTER TERABIT_SRCS EXCLUDE REGEX ".*windows.*")
if(TERABIT_SRCS)
    add_library(Terabit STATIC ${TERABIT_SRCS})
    target_link_libraries(Terabit PRIVATE ${ACE_LIBRARY} ${CMAKE_THREAD_LIBS_INIT})
else()
    add_library(Terabit INTERFACE)
endif()

# --- Thrift (vendored) ---
file(GLOB_RECURSE THRIFT_SRCS ${VENDOR}/Thrift/thrift-0.9.1/lib/cpp/src/*.cpp)
list(FILTER THRIFT_SRCS EXCLUDE REGEX ".*windows.*")
list(FILTER THRIFT_SRCS EXCLUDE REGEX ".*Evhttp.*")
list(FILTER THRIFT_SRCS EXCLUDE REGEX ".*SSL.*")
list(FILTER THRIFT_SRCS EXCLUDE REGEX ".*server/simple.*")
if(THRIFT_SRCS)
    add_library(thrift STATIC ${THRIFT_SRCS})
    target_link_libraries(thrift PRIVATE ${CMAKE_THREAD_LIBS_INIT})

else()
    add_library(thrift INTERFACE)
endif()

# --- mongoose (vendored, single C file) ---
if(EXISTS ${VENDOR}/mongoose/mongoose.c)
    add_library(mongoose STATIC ${VENDOR}/mongoose/mongoose.c)
    target_compile_options(mongoose PRIVATE "-include" "${VENDOR}/mongoose/mongoose_linux_prelude.h")
else()
    add_library(mongoose INTERFACE)
endif()

# --- wsdlpull (vendored) ---
file(GLOB_RECURSE WSDLPULL_SRCS ${VENDOR}/wsdlpull/src/*.cpp)
list(FILTER WSDLPULL_SRCS EXCLUDE REGEX ".*win32.*")
if(WSDLPULL_SRCS)
    add_library(wsdlpull STATIC ${WSDLPULL_SRCS})
    target_compile_options(wsdlpull PRIVATE -include unistd.h)
    target_compile_definitions(wsdlpull PRIVATE PACKAGE_VERSION="1.0")
else()
    add_library(wsdlpull INTERFACE)
endif()

# --- MD4 (vendored, skipped due to GCC 15 compatibility) ---
add_library(md4 INTERFACE)

# --- UnixEnv (vendored compat layer) ---
file(GLOB UNIXENV_SRCS ${VENDOR}/UnixEnv/*.cpp ${VENDOR}/UnixEnv/*.c)
if(UNIXENV_SRCS)
    add_library(unixenv STATIC ${UNIXENV_SRCS})
else()
    add_library(unixenv INTERFACE)
endif()

# ============================================================
# Collect UniServerApp sources
# ============================================================
set(ALL_SOURCES "")

file(STRINGS ${AUTO_DIR}/CMakeLists.txt CMK_INCLUDES REGEX "^include\\(")
foreach(INCLUDE_LINE ${CMK_INCLUDES})
    string(REGEX MATCH "include\\((.+\\.cmake)\\)" _ "${INCLUDE_LINE}")
    set(CMAKE_FILE "${CMAKE_MATCH_1}")
    if(NOT CMAKE_FILE)
        continue()
    endif()
    if(NOT IS_ABSOLUTE ${CMAKE_FILE})
        set(CMAKE_FILE ${AUTO_DIR}/${CMAKE_FILE})
    endif()
    if(NOT EXISTS ${CMAKE_FILE})
        continue()
    endif()
    file(READ ${CMAKE_FILE} CMK_CONTENT)
    string(REGEX MATCH "set\\(SOURCES_[^ ]+ (.+)\\)" _ "${CMK_CONTENT}")
    if(CMAKE_MATCH_1)
        separate_arguments(SRC_LIST UNIX_COMMAND "${CMAKE_MATCH_1}")
        foreach(SRC ${SRC_LIST})
            get_filename_component(CMK_DIR ${CMAKE_FILE} DIRECTORY)
            set(FULL_SRC ${CMK_DIR}/${SRC})
            if(EXISTS ${FULL_SRC})
                list(APPEND ALL_SOURCES ${FULL_SRC})
            endif()
        endforeach()
    endif()
endforeach()

list(REMOVE_DUPLICATES ALL_SOURCES)
list(LENGTH ALL_SOURCES SRC_COUNT)
message(STATUS "Collected ${SRC_COUNT} source files")

# ============================================================
# Main executable
# ============================================================
add_executable(${PROJECT_NAME} ${ALL_SOURCES})

target_link_libraries(${PROJECT_NAME} PRIVATE
    ${ACE_LIBRARY}        # system ACE
    Terabit               # vendored
    ${CURL_LIBRARY}       # system curl
    ${TINYXML_LIBRARY}    # system tinyxml
    ${JSONCPP_LIBRARY}    # system jsoncpp
    thrift                # vendored
    mongoose              # vendored
    wsdlpull              # vendored
    md4                   # vendored
    unixenv               # vendored
    ${ZLIB_LIB}           # system zlib
    ${CMAKE_THREAD_LIBS_INIT}
    ssl
    crypto
    dl
    rt
    pthread
)

# ============================================================
# Build type defaults
# ============================================================
if(NOT CMAKE_BUILD_TYPE)
    set(CMAKE_BUILD_TYPE Release)
endif()

set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -Wall -Wextra -Wno-implicit-fallthrough")
set(CMAKE_CXX_FLAGS_RELEASE "-O2 -DNDEBUG")
set(CMAKE_CXX_FLAGS_DEBUG "-g -O0")
