cmake_minimum_required(VERSION 3.10)
project(UniServerApp C CXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

# ============================================================
# Platform detection
# ============================================================
if(WIN32)
    add_definitions(-DNV_WIN_PLATFORM)
else()
    add_definitions(-DNV_LINUX_PLATFORM)
endif()

# ============================================================
# Directories
# ============================================================
set(PROJECT_ROOT ${CMAKE_CURRENT_SOURCE_DIR}/../../../../..)
set(SRC_DIR ${PROJECT_ROOT}/Src)
set(VENDOR ${PROJECT_ROOT}/Vendor)
set(AUTO_DIR ${CMAKE_CURRENT_SOURCE_DIR}/../UniServerApp.auto)

# ============================================================
# Find system packages
# ============================================================
find_package(Threads REQUIRED)
find_package(ZLIB REQUIRED)

# ACE (system)
find_path(ACE_INCLUDE_DIR ace/ACE.h PATHS /usr/include)
find_library(ACE_LIBRARY NAMES ACE PATHS /usr/lib/x86_64-linux-gnu)

# curl (system)
find_path(CURL_INCLUDE_DIR curl/curl.h PATHS /usr/include/x86_64-linux-gnu)
find_library(CURL_LIBRARY NAMES curl PATHS /usr/lib/x86_64-linux-gnu)

# tinyxml (system)
find_path(TINYXML_INCLUDE_DIR tinyxml.h PATHS /usr/include)
find_library(TINYXML_LIBRARY NAMES tinyxml PATHS /usr/lib/x86_64-linux-gnu)

# jsoncpp (system)
find_path(JSONCPP_INCLUDE_DIR json/json.h PATHS /usr/include/jsoncpp)
find_library(JSONCPP_LIBRARY NAMES jsoncpp PATHS /usr/lib/x86_64-linux-gnu)

message(STATUS "ACE: ${ACE_INCLUDE_DIR} ${ACE_LIBRARY}")
message(STATUS "curl: ${CURL_INCLUDE_DIR} ${CURL_LIBRARY}")
message(STATUS "tinyxml: ${TINYXML_INCLUDE_DIR} ${TINYXML_LIBRARY}")
message(STATUS "jsoncpp: ${JSONCPP_INCLUDE_DIR} ${JSONCPP_LIBRARY}")

# ============================================================
# Compiler flags
# ============================================================
add_definitions(
    -DDO_NOT_USE_DLLMAIN
    -DBOOST_ALL_NO_LIB
    -DTRANSPORT_LAYER_COMPONENT
    -DNI_FORCE_DISABLE_INLINE_PROFILER
    -DNI_DISABLE_CRASHRPT
    -DVISUAL_CUTTED
    -DSERVER_DB
    -D_DO_ASSERT
    -DDB_TYPES_REGISTRATOR_SILENT
    -DLOG_THREAD_EXIT
    -DCHECK_TOWN_CONSISTENCY
)

# ACE_RCSID removed from system ACE 8.x - define as noop
add_definitions(-DACE_RCSID="")

