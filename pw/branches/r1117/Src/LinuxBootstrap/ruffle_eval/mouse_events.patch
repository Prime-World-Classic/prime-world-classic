 use std::cell::{Ref, RefMut};
 use std::fmt::Debug;

+/// Opt-in Tamarin names used by Prime World's original ActionScript handlers.
+fn primeworld_right_mouse_event(standard: &str) -> &str {
+	if cfg!(feature = "primeworld_mouse_events") {
+		match standard {
+			"rightMouseDown" => "mouseRightDown",
+			"rightMouseUp" => "mouseRightUp",
+			"rightClick" => "clickRight",
+			_ => standard,
+		}
+	} else {
+		standard
+	}
+}
+
+#[cfg(test)]
+mod primeworld_mouse_tests {
+	#[test]
+	fn names_are_opt_in_and_preserve_other_events() {
+		for (standard, legacy) in [("rightMouseDown", "mouseRightDown"),
+			("rightMouseUp", "mouseRightUp"), ("rightClick", "clickRight"),
+			("mouseDown", "mouseDown"), ("middleClick", "middleClick")] {
+			assert_eq!(super::primeworld_right_mouse_event(standard),
+				if cfg!(feature = "primeworld_mouse_events") { legacy } else { standard });
+		}
+	}
+}
