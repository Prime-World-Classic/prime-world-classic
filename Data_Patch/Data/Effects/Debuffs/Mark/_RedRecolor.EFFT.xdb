<?xml version="1.0" encoding="utf-8"?>
<ScaleColorEffect>
	<blendMode>LerpByAlpha</blendMode>
	<colorAdd><A>0</A><B>0</B><G>0</G><R>0</R></colorAdd>
	<colorMul><A>1</A><B>0.1</B><G>0.05</G><R>2</R></colorMul>
	<deathType>Manual</deathType>
	<enableCondition href="" />
	<fadeInTime>0</fadeInTime>
	<fadeOutTime>0.3</fadeOutTime>
	<fullRecolor>true</fullRecolor>
	<lifeTime>0</lifeTime>
	<scale>1</scale>
	<scaleIn>1</scaleIn>
	<scaleOut>1</scaleOut>
</ScaleColorEffect>
